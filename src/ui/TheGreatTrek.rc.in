// Windows resources for TheGreatTrek.exe: the program icon (Explorer, the taskbar, shortcuts and
// any installer) and the version shown in the file's properties. CMake fills in the paths and version.
#include <winver.h>

1 ICON "@TREK_ICON_ICO@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "The Great Trek"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "The Great Trek / Die Groot Trek"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "GPL-3.0"
            VALUE "OriginalFilename", "TheGreatTrek.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
